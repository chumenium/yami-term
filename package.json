{
  "name": "yami-term",
  "version": "0.6.0",
  "description": "🖤 Liquid Glass terminal emulator for macOS and Windows — tabs, GUI settings, shell-history suggestions",
  "main": "main.js",
  "author": "chumenium",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chumenium/yami-term.git"
  },
  "homepage": "https://github.com/chumenium/yami-term",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.3.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.0.12"
  },
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty",
    "test": "node --test",
    "dist": "electron-builder --mac",
    "dist:arm64": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win",
    "verify:dist": "bash scripts/verify-dist.sh"
  },
  "build": {
    "appId": "com.chumenium.yamiterm",
    "productName": "yami-term",
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "renderer/**/*",
      "!tests/**",
      "!scripts/**",
      "!assets/**",
      "!dist/**",
      "!.github/**",
      "!*.md"
    ],
    "afterSign": "scripts/afterSign.js",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
